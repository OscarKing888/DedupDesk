<Window x:Class="DedupDesk.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DedupDesk · 多线程文件去重" Width="1360" Height="920" MinWidth="1080" MinHeight="760" Background="#F3F5F9" Foreground="#17233A" FontFamily="Microsoft YaHei UI" FontSize="13" WindowStartupLocation="CenterScreen" Closing="Window_Closing">
 <Grid Margin="26,20"><Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><StackPanel><TextBlock Text="DedupDesk" FontSize="29" FontWeight="Bold"/><TextBlock Text="多磁盘并行扫描 · 本地指纹库 · 只移入回收站" Foreground="#64748B" Margin="0,3,0,0"/></StackPanel><Button Content="设置与缓存" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Settings_Click" x:Name="SettingsButton"/></Grid>
  <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="18" Margin="0,10,0,12">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
    <Grid Margin="0,0,24,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="126"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,9"><TextBlock Text="01  扫描目录" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="＋ 添加目录" Click="AddRoot_Click" x:Name="AddButton"/><Button Content="移除" Click="RemoveRoot_Click" x:Name="RemoveButton" Margin="0"/></StackPanel></DockPanel>
     <DataGrid x:Name="RootsGrid" Grid.Row="1" CellEditEnding="Roots_EditEnding" SelectionMode="Extended"><DataGrid.Columns><DataGridTextColumn Header="目录" Binding="{Binding Path}" Width="*" IsReadOnly="True"/><DataGridComboBoxColumn x:Name="RoleColumn" Header="用途" SelectedItemBinding="{Binding RoleLabel, UpdateSourceTrigger=PropertyChanged}" Width="130"/></DataGrid.Columns></DataGrid>
     <TextBlock Grid.Row="2" Text="保留目录优先。仅回收与保留目录中副本匹配的目标文件。" Foreground="#64748B" FontSize="12" Margin="0,8,0,0"/>
    </Grid>
    <StackPanel Grid.Column="1" x:Name="OptionsPanel"><TextBlock Text="02  比较规则" FontWeight="Bold" FontSize="15" Margin="0,6,0,13"/>
     <WrapPanel><RadioButton x:Name="NameMode" Content="名字＋大小" GroupName="Mode" IsChecked="True" Checked="RuleChanged"/><RadioButton x:Name="Md5Mode" Content="MD5" GroupName="Mode" Checked="RuleChanged"/><RadioButton x:Name="ShaMode" Content="SHA-256" GroupName="Mode" Checked="RuleChanged"/></WrapPanel>
     <TextBlock x:Name="ModeHint" Text="未核验内容。速度最快，不读取文件内容。" Foreground="#A16207" TextWrapping="Wrap" Margin="0,6,0,12"/>
     <DockPanel><TextBlock Text="文件类型" VerticalAlignment="Center" Margin="0,0,12,0"/><ComboBox x:Name="FilterBox" SelectionChanged="FilterChanged"/></DockPanel>
     <TextBox x:Name="ExtensionsBox" Margin="0,8,0,0" ToolTip="预设可以直接编辑；扩展名用空格、逗号或分号分隔" TextChanged="ExtensionsChanged"/>
    </StackPanel>
   </Grid>
  </Border>
  <DockPanel Grid.Row="2" Margin="0,0,0,12"><StackPanel Orientation="Horizontal"><Button x:Name="ScanButton" Content="开始扫描" Background="#2563EB" Foreground="White" BorderBrush="#2563EB" Click="Scan_Click"/><Button x:Name="ResumeButton" Content="恢复上次任务" Click="Resume_Click"/><Button x:Name="PauseButton" Content="暂停" IsEnabled="False" Click="Pause_Click"/><Button x:Name="CancelButton" Content="取消" IsEnabled="False" Click="Cancel_Click"/></StackPanel><TextBlock x:Name="SummaryText" Text="添加目录后开始扫描，所有数据仅保存在本机。" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#50617A" TextTrimming="CharacterEllipsis"/></DockPanel>
  <Border Grid.Row="3" Background="White" CornerRadius="10" Padding="16">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,12"><StackPanel Orientation="Horizontal"><TextBlock Text="03  扫描结果" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,18,0"/><RadioButton x:Name="ListMode" Content="重复组列表" GroupName="View" IsChecked="True" Checked="ViewChanged"/><RadioButton x:Name="TreeMode" Content="目录树" GroupName="View" Checked="ViewChanged"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBox x:Name="SearchBox" Width="185" ToolTip="搜索文件路径" KeyDown="Search_KeyDown"/><Button Content="搜索" Margin="8,0,8,0" Click="Search_Click"/><ComboBox x:Name="SortBox" Width="100" SelectionChanged="SortChanged"/><CheckBox x:Name="DescendingBox" Content="降序" Margin="10,0,0,0" Checked="SortChanged" Unchecked="SortChanged"/></StackPanel></DockPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition x:Name="TreeColumn" Width="0"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <TreeView x:Name="FolderTree" BorderThickness="0" Margin="0,0,12,0" SelectedItemChanged="Tree_Selected" PreviewMouseRightButtonDown="Tree_RightClick" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"><TreeView.ContextMenu><ContextMenu><MenuItem Header="将此目录下的匹配文件移入回收站" Click="RecycleFolder_Click"/><MenuItem Header="打开所在目录" Click="OpenTree_Click"/><MenuItem Header="复制路径" Click="CopyTree_Click"/></ContextMenu></TreeView.ContextMenu></TreeView>
     <DataGrid x:Name="ResultsGrid" Grid.Column="1" SelectionMode="Extended" SelectionUnit="FullRow" CanUserSortColumns="False" PreviewMouseRightButtonDown="Results_RightClick"><DataGrid.ContextMenu><ContextMenu><MenuItem Header="将选中的文件移入回收站" Click="RecycleSelected_Click"/><Separator/><MenuItem Header="打开所在目录" Click="Open_Click"/><MenuItem Header="复制路径" Click="Copy_Click"/></ContextMenu></DataGrid.ContextMenu>
      <DataGrid.Columns><DataGridTemplateColumn Width="38"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSelect}" HorizontalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="文件名" Binding="{Binding Name}" Width="160" IsReadOnly="True"/><DataGridTextColumn Header="大小" Binding="{Binding SizeLabel}" Width="85" IsReadOnly="True"/><DataGridTextColumn Header="角色" Binding="{Binding RoleLabel}" Width="65" IsReadOnly="True"/><DataGridTextColumn Header="重复组" Binding="{Binding GroupLabel}" Width="110" IsReadOnly="True"/><DataGridTextColumn Header="匹配方式" Binding="{Binding ComparisonLabel}" Width="100" IsReadOnly="True"/><DataGridTextColumn Header="完整路径" Binding="{Binding Path}" Width="*" MinWidth="180" IsReadOnly="True"/><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="115" IsReadOnly="True"/></DataGrid.Columns>
     </DataGrid>
     <TextBlock x:Name="EmptyText" Grid.Column="1" Text="扫描完成后，重复文件会显示在这里。" Foreground="#94A3B8" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"/>
    </Grid>
    <DockPanel Grid.Row="2" Margin="0,12,0,0"><StackPanel Orientation="Horizontal"><Button Content="选择本页可清理项" Click="SelectPage_Click"/><Button Content="移入回收站" Click="RecycleSelected_Click" x:Name="RecycleButton"/><Button Content="错误记录" Click="Errors_Click"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="上一页" Click="Prev_Click"/><TextBlock x:Name="PageText" Text="第 0 / 0 页" VerticalAlignment="Center" Margin="4,0,12,0"/><Button Content="下一页" Click="Next_Click" Margin="0"/></StackPanel></DockPanel>
   </Grid>
  </Border>
  <StackPanel Grid.Row="4" Margin="0,12,0,0"><ProgressBar x:Name="ActivityBar" Height="3" Minimum="0" Maximum="1"/><TextBlock x:Name="ProgressText" Text="就绪" Foreground="#64748B" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel>
 </Grid>
</Window>
